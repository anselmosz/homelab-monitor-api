{
  "name": "homelab-monitor-api",
  "version": "0.1.0",
  "description": "API de coleta e exposição de métricas do homelab rodando em Termux (SSH, banco de dados, uso de recursos do sistema).",
  "license": "ISC",
  "author": "anselmosz",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "NODE_ENV=production node server.js",
    "dev": "NODE_ENV=development node --watch server.js",
    "pm2:start": "npx pm2 start ecosystem.config.cjs",
    "pm2:start:prod": "npx pm2 start ecosystem.config.cjs --env production",
    "pm2:restart": "npx pm2 restart homalab-monitor-api",
    "pm2:stop": "npx pm2 stop homelab-monitor-api",
    "pm2:logs": "npx pm2 logs homelab-monitor-api"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "pm2": "^7.0.4"
  },
  "private": true
}
